# ===================================================================
# RailReserve - Environment Configuration Template
# Copy this file to .env or export these variables in your environment.
# NEVER commit real production credentials to version control.
# ===================================================================

# -------------------------------------------------------------------
# 0. Runtime & Profile Configuration
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
CORS_ALLOWED_ORIGINS=https://railway-reservation-system.onrender.com

# -------------------------------------------------------------------
# 1. Database Configuration (Render Managed PostgreSQL or MySQL)
# -------------------------------------------------------------------
# Render automatically sets DATABASE_URL: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://railway_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/railway_reservation

# Alternatively for standalone JDBC:
DB_URL=jdbc:postgresql://localhost:5432/railway_reservation
DB_USERNAME=railway_user
DB_PASSWORD=your_secure_db_password
DB_DRIVER=org.postgresql.Driver

# -------------------------------------------------------------------
# 2. Payment Gateway Integration (Razorpay / Mock)
# -------------------------------------------------------------------
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# -------------------------------------------------------------------
# 3. Indian Railway Real Data Provider API Configuration (Optional)
# -------------------------------------------------------------------
RAILWAY_API_PROVIDER=mock
RAILWAY_API_BASE_URL=https://irctc1.p.rapidapi.com/api/v1
RAILWAY_API_KEY=your_railway_api_key

RAILWAY_SEARCH_PROVIDER=rapidapi
RAILWAY_SEARCH_API_URL=https://irctc1.p.rapidapi.com/api/v1/trainsBetweenStations
RAILWAY_SEARCH_API_KEY=your_railway_search_api_key

RAILWAY_AVAILABILITY_PROVIDER=rapidapi
RAILWAY_AVAILABILITY_API_URL=https://irctc1.p.rapidapi.com/api/v1/checkSeatAvailability
RAILWAY_AVAILABILITY_API_KEY=your_railway_availability_api_key

RAILWAY_FARE_PROVIDER=rapidapi
RAILWAY_FARE_API_URL=https://irctc1.p.rapidapi.com/api/v2/getFare
RAILWAY_FARE_API_KEY=your_railway_fare_api_key

# -------------------------------------------------------------------
# 4. Transactional SMS & Email Configuration (Optional)
# -------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

EMAIL_PROVIDER=mock
EMAIL_API_KEY=your_email_api_key
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=your_smtp_password
